{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build ktGeniusExam (Release)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build",
        "--config",
        "Release"
      ],
      "group": "build",
      "problemMatcher": [],
      "detail": "빌드: CMake Release 빌드"
    },
    {
      "label": "Build ktGeniusExam (Debug)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build",
        "--config",
        "Debug"
      ],
      "group": "build",
      "problemMatcher": [],
      "detail": "빌드: CMake Debug 빌드"
    }
  ]
}

